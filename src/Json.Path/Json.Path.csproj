<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Json.Path</AssemblyName>
    <RootNamespace>Json.Path</RootNamespace>
    <Description>Lightweight helpers for compiling and resolving simple JSONPath expressions.</Description>
    <PackageId>Json.Path</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="11.5.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Parsing/JsonPathTest.g4">
      <Package>Json.Path.Parsing</Package>
    </Antlr4>
  </ItemGroup>
</Project>
